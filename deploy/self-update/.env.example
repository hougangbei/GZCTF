# Copy to .env in the deployment directory and replace the secrets.
GZCTF_IMAGE=ghcr.io/hougangbei/gzctf:main
GZCTF_PORT=8080
POSTGRES_PASSWORD=replace-with-a-long-random-password
GZCTF_XOR_KEY=replace-with-a-long-random-key
GZCTF_ADMIN_PASSWORD=replace-with-a-strong-admin-password
GZCTF_TRUSTED_PROXY=
# Fill these on the host before enabling email verification and registration review.
SMTP_SENDER_ADDRESS=
SMTP_SENDER_NAME=GZCTF
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
